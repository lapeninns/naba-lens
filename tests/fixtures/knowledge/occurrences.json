{
  "note": "Shared by tests/unit/knowledge-b03-schedules.test.ts (expandScheduleOccurrences) and tests/security/knowledge-b03-schedules.test.ts (private.schedule_occurrences). Instants are UTC. B04 reuses this expansion (b03-design A27).",
  "cases": [
    {
      "name": "weekly roast across the October clock change, with a cancelled, a changed and an extra date, ending on effectiveTo",
      "input": {
        "timezone": "Europe/London",
        "effectiveFrom": "2026-10-01",
        "effectiveTo": "2026-11-22",
        "recurrence": {
          "kind": "weekly",
          "days": ["sun"]
        },
        "windows": [
          {
            "start": "12:00",
            "end": "15:00"
          }
        ],
        "exceptions": [
          {
            "localDate": "2026-11-08",
            "kind": "cancelled"
          },
          {
            "localDate": "2026-11-15",
            "kind": "changed_window",
            "windows": [
              {
                "start": "13:00",
                "end": "16:00"
              }
            ]
          },
          {
            "localDate": "2026-11-11",
            "kind": "extra",
            "windows": [
              {
                "start": "18:00",
                "end": "20:00"
              }
            ]
          }
        ],
        "from": "2026-10-18",
        "to": "2026-11-30"
      },
      "expect": {
        "occurrences": [
          {
            "state": "scheduled",
            "endsAt": "2026-10-18T14:00:00.000Z",
            "startsAt": "2026-10-18T11:00:00.000Z",
            "localDate": "2026-10-18"
          },
          {
            "state": "scheduled",
            "endsAt": "2026-10-25T15:00:00.000Z",
            "startsAt": "2026-10-25T12:00:00.000Z",
            "localDate": "2026-10-25"
          },
          {
            "state": "scheduled",
            "endsAt": "2026-11-01T15:00:00.000Z",
            "startsAt": "2026-11-01T12:00:00.000Z",
            "localDate": "2026-11-01"
          },
          {
            "state": "cancelled",
            "endsAt": "2026-11-08T15:00:00.000Z",
            "startsAt": "2026-11-08T12:00:00.000Z",
            "localDate": "2026-11-08"
          },
          {
            "state": "extra",
            "endsAt": "2026-11-11T20:00:00.000Z",
            "startsAt": "2026-11-11T18:00:00.000Z",
            "localDate": "2026-11-11"
          },
          {
            "state": "changed",
            "endsAt": "2026-11-15T16:00:00.000Z",
            "startsAt": "2026-11-15T13:00:00.000Z",
            "localDate": "2026-11-15"
          },
          {
            "state": "scheduled",
            "endsAt": "2026-11-22T15:00:00.000Z",
            "startsAt": "2026-11-22T12:00:00.000Z",
            "localDate": "2026-11-22"
          }
        ]
      }
    },
