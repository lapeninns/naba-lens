# Naba-Lens environment. Names only: never commit values.
# Local values: run `supabase status` after `supabase start` (API_URL, PUBLISHABLE_KEY
# or ANON_KEY, SERVICE_ROLE_KEY) and put them in .env.local (git-ignored).

# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Absolute origin used for auth email links, e.g. http://127.0.0.1:3000 locally
NEXT_PUBLIC_SITE_URL=
# Public Turnstile site key. Requires a rebuild; leave empty for local fixtures.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only: set true with the public key when Supabase Auth CAPTCHA is enabled.
# A missing key or token then blocks sign-in instead of silently bypassing CAPTCHA.
# The Turnstile SECRET belongs in Supabase Auth settings, never this application.
AUTH_CAPTCHA_ENABLED=

# Server only: bypasses RLS. Used by lib/supabase/admin.ts and operator scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Server only: shared secret for POST /api/internal/cleanup (docs/cleanup.md).
# At least 32 characters, e.g. `openssl rand -hex 32`.
CLEANUP_SECRET=

# Optional server only: independent read-only archive health credential.
# 32–256 ASCII letters, digits, underscores or hyphens. Never reuse CLEANUP_SECRET.
# Accepted only by GET /api/internal/media-archive/status; no copy/delete authority.
# Store the matching local monitor value in macOS Keychain, not a dotenv file:
# service naba-lens-production-archive-monitor, account https://naba-lens.vercel.app.
MEDIA_ARCHIVE_MONITOR_SECRET=

# Server only: Vercel cron bearer, including the independent monitor watchdog.
# Keep separate from the narrow status and heartbeat credentials.
CRON_SECRET=

# Server only: narrow POST /api/internal/archive-monitor/heartbeat credential.
# 32–256 URL-safe characters; distinct from monitor/cron/cleanup secrets.
# Matching Worker secret authenticates heartbeat only, never archive operations.
ARCHIVE_MONITOR_HEARTBEAT_SECRET=
# Existing Resend: dedicated sending-only key limited to the confirmed sender domain.
# These belong only to Vercel; never put them in the Cloudflare checker.
ARCHIVE_WATCHDOG_RESEND_API_KEY=
ARCHIVE_WATCHDOG_EMAIL_FROM=

# Cloudflare Worker config is separate from this application's dotenv file:
# CHECKER_STATE: dedicated KV binding.
# ARCHIVE_ALERT_EMAIL: send_email binding restricted to the fixed verified owner.
# ALERT_EMAIL_FROM: confirmed sender from an existing routed/onboarded domain.
# Worker secrets: MEDIA_ARCHIVE_MONITOR_SECRET, ARCHIVE_MONITOR_HEARTBEAT_SECRET.
# No cleanup, cron, Supabase, R2 or Resend credentials in that Worker.

# Local fixtures may explicitly disable archival. Every hosted deployment must
# select a mode; production must use required plus its dedicated private R2 bucket.
MEDIA_ARCHIVE_MODE=disabled
# Hosted only: production or staging, independent of Vercel's deployment target.
# NABALENS_ENVIRONMENT=
# Hosted only: production Supabase ref in BOTH projects; binds environment identity.
# MEDIA_ARCHIVE_PRODUCTION_PROJECT_REF=
# MEDIA_ARCHIVE_SOURCE_PROJECT_REF=
# MEDIA_ARCHIVE_R2_ACCOUNT_ID=
# MEDIA_ARCHIVE_R2_BUCKET=
# MEDIA_ARCHIVE_R2_ACCESS_KEY_ID=
# MEDIA_ARCHIVE_R2_SECRET_ACCESS_KEY=
